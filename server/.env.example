# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (create the user/database first, see README).
DATABASE_URL=postgresql://ryvon:YOUR_DB_PASSWORD@localhost:5432/ryvon

# REQUIRED, at least 32 characters. Generate one with:
JWT_SECRET=
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-15). Higher = slower and safer.
BCRYPT_ROUNDS=12

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the frontend is served by this server (same origin).
# Example for VS Code Live Server: http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=

# Behind a reverse proxy (nginx, Render, Railway...)? Set to the number of proxies, e.g. 1.
TRUST_PROXY=

# Timezone used to decide what "today" means for past-date checks and booking status.
BUSINESS_TIMEZONE=Asia/Kolkata

# Longest allowed rental, in days.
MAX_BOOKING_DAYS=30

# Rate limits per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300

# Folder containing index.html / pages / assets. Default is the parent of server/.
# FRONTEND_DIR=..

#   http://localhost:3000
#   http://127.0.0.1:3000

