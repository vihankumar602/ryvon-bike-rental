{
  "name": "ryvon-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RYVON Bike Rental backend: Express + PostgreSQL + Prisma",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "test": "node --test --test-concurrency=1 tests/unit.test.js tests/auth.test.js tests/api.test.js",
    "test:e2e": "node scripts/e2e-user-journey.js",
    "extract-data": "node scripts/extract-frontend-data.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "supertest": "^7.0.0"
  }
}
